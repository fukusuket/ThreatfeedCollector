LLM_PROVIDER=openai
OPENAI_API_KEY=your-open-api-key
# GPT-5.5 on Bedrock is available only in us-east-1 / us-east-2
AWS_REGION=us-east-1
# GPT on Bedrock (default): openai.gpt-5.5 — uses the bedrock-mantle
# Responses API and requires AWS_BEARER_TOKEN_BEDROCK (Bedrock API key)
# Anthropic on Bedrock: apac.anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_MODEL_ID=openai.gpt-5.5
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
MISP_URL=https://misp-core
MISP_KEY=your-misp-key
DAYS_BACK=7